@model Ecommerce_Vault.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Finalizar compra";
}

<div class="container my-5">
    <h1 class="fw-black text-uppercase text-white tracking-widest mb-4 d-flex align-items-center">
        <i class="bi bi-bag-check me-3 text-warning"></i> Finalizar compra
    </h1>

    <form asp-controller="Ventas" asp-action="ConfirmarCompra" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-4">

            <!-- Datos del Cliente / Formulario de Envío -->
            <div class="col-12 col-lg-7">
                <div class="border border-secondary bg-black p-4">
                    <h5 class="text-white text-uppercase fw-bold mb-4 border-bottom border-secondary pb-2">Datos de la compra</h5>

                    <!-- Dirección y Teléfono predeterminados/confirmados -->
                    <div class="border border-secondary p-3 mb-4 bg-dark">
                        <div class="d-flex align-items-center text-secondary fs-7">
                            <i class="bi bi-geo-alt me-2 text-white"></i>
                            <span>Entrega en: <strong class="text-white">@Model.DireccionEntrega</strong> · <i class="bi bi-telephone text-white ms-2"></i> <strong class="text-white">@Model.Telefono</strong></span>
                        </div>
                    </div>

                    <input type="hidden" asp-for="DireccionEntrega" />
                    <input type="hidden" asp-for="Telefono" />

                    <!-- Forma de pago -->
                    <div class="mb-4">
                        <label class="form-label text-uppercase fs-7 text-secondary fw-semibold">Forma de pago</label>
                        <select asp-for="FormaPago" class="form-select bg-dark text-white border-secondary shadow-none rounded-0">
                            <option value="">-- Elegir --</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="QR">QR</option>
                            <option value="Tarjeta">Tarjeta</option>
                            <option value="Transferencia">Transferencia</option>
                        </select>
                        <span asp-validation-for="FormaPago" class="text-danger fs-8"></span>
                    </div>

                    <!-- Observaciones opcionales -->
                    <div class="mb-3">
                        <label class="form-label text-uppercase fs-7 text-secondary fw-semibold">Observaciones (opcional)</label>
                        <textarea asp-for="Observaciones" rows="3" class="form-control bg-dark text-white border-secondary shadow-none rounded-0"
                                  placeholder="Ej: entregar por la tarde, tocar timbre..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Resumen de Pedido y Confirmación -->
            <div class="col-12 col-lg-5">
                <div class="border border-secondary bg-black p-4">
                    <h5 class="text-white text-uppercase fw-bold mb-3 border-bottom border-secondary pb-2">Resumen</h5>

                    <div class="mb-3">
                        @foreach (var item in Model.Items)
                        {
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-secondary">
                                <div>
                                    <p class="text-white fw-bold mb-0 fs-7 text-uppercase">@item.Nombre</p>
                                    <small class="text-secondary fs-8">@item.Cantidad x Bs @item.Precio.ToString("F2")</small>
                                </div>
                                <span class="text-white fw-semibold fs-7">Bs @item.Subtotal.ToString("F2")</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between text-white border-top border-secondary pt-3 fs-5 fw-black">
                        <span>Total</span>
                        <span style="color: #8C6D53;">Bs @Model.Total.ToString("F2")</span>
                    </div>

                    <button type="submit" class="btn w-100 rounded-0 text-uppercase fw-bold mt-4 py-2" style="background-color: #8C6D53; color: #fff;">
                        <i class="bi bi-check-circle me-2"></i> Confirmar compra
                    </button>

                    <div class="text-center mt-3">
                        <a asp-controller="Cart" asp-action="Index" class="text-secondary text-decoration-none fs-7 hover-warning">
                            Volver al carrito
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>