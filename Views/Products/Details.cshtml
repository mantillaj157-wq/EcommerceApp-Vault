@model Ecommerce_Vault.Models.Product

@{
    ViewData["Title"] = Model.Name;

    // Cálculo del 10% de descuento por transferencia bancaria
    decimal transferPrice = Model.Price * 0.90m;

    // Procesar las URLs guardadas en la base de datos (separadas por comas)
    var imageList = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        // Separar las URLs por coma y eliminar espacios en blanco sobrantes
        imageList = Model.ImageUrl
            .Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(img => img.Trim())
            .ToList();
    }

    // Si no hay imágenes válidas, colocar una por defecto
    if (!imageList.Any())
    {
        imageList.Add("https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?q=80&w=800&auto=format&fit=crop");
    }
}

<!-- ESTILOS VISUALES DE VAULT -->
<style>
    /* Miniaturas laterales */
    .thumb-gallery {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: 500px;
        overflow-y: auto;
    }

    .thumb-img {
        width: 80px;
        height: 95px;
        object-fit: cover;
        cursor: pointer;
        border: 1px solid #2A2A2A;
        opacity: 0.5;
        transition: all 0.2s ease;
    }

        .thumb-img:hover, .thumb-img.active {
            opacity: 1;
            border-color: #8C6D53;
        }

    /* Visor de la imagen principal con Lupa */
    .zoom-container {
        position: relative;
        overflow: hidden;
        width: 100%;
        height: 500px;
        background-color: #0A0A0A;
        border: 1px solid #222;
        cursor: crosshair;
    }

        .zoom-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.1s ease-out;
            transform-origin: center center;
        }

    /* Botón AGREGAR AL CARRITO */
    .btn-vault-action {
        background-color: #8C6D53;
        color: #FFFFFF;
        border: none;
        font-weight: 700;
        letter-spacing: 1.5px;
        padding: 14px 20px;
        transition: background-color 0.2s ease;
    }

        .btn-vault-action:hover {
            background-color: #a37a5b;
            color: #FFFFFF;
        }

    /* Estilos para las tarjetas de descripción */
    .desc-card {
        background-color: #111111;
        border: 1px solid #222222;
        padding: 24px;
        border-radius: 4px;
    }

    .spec-badge {
        background-color: #1A1A1A;
        color: #CCCCCC;
        border: 1px solid #333333;
        padding: 6px 14px;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        display: inline-block;
    }
</style>

<div class="container my-4">

    <!-- BREADCRUMB / NAVEGACIÓN SUPERIOR -->
    <nav class="mb-4 text-uppercase fw-semibold" style="font-size: 0.75rem;">
        <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none">Inicio</a>
        <span class="text-muted mx-2">/</span>
        <a asp-controller="Products" asp-action="Index" class="text-secondary text-decoration-none">@Model.Category</a>
        <span class="text-muted mx-2">/</span>
        <span class="text-white">@Model.Name</span>
    </nav>

    <div class="row g-4">

        <!-- COLUMNA IZQUIERDA: GALERÍA DE FOTOS Y EFECTO LUPA -->
        <div class="col-12 col-lg-7">
            <div class="d-flex gap-3">
                <!-- Miniaturas de la izquierda -->
                <div class="thumb-gallery d-none d-md-flex">
                    @for (int i = 0; i < imageList.Count; i++)
                    {
                        <img src="@imageList[i]"
                             class="thumb-img @(i == 0 ? "active" : "")"
                             onclick="changeMainImage('@imageList[i]', this)"
                             alt="Vista previa @i" />
                    }
                </div>

                <!-- Visor principal zoomable -->
                <div class="flex-grow-1">
                    <div class="zoom-container" id="zoomArea" onmousemove="zoomIn(event)" onmouseleave="zoomOut()">
                        <img id="mainProductImage" src="@imageList[0]" alt="@Model.Name" />
                    </div>
                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA: COMPRA, PRECIOS Y STOCK -->
        <div class="col-12 col-lg-5 ps-lg-4">
            <h1 class="text-white text-uppercase fw-bold mb-3 fs-3">@Model.Name</h1>

            <!-- Precios -->
            <div class="mb-3">
                <div class="display-6 fw-bold text-white">Bs. @Model.Price.ToString("N2")</div>
                <div class="text-secondary fs-6 mt-1">
                    <strong class="text-warning">Bs. @transferPrice.ToString("N2")</strong> pagando con Transferencia
                </div>
            </div>

            <hr class="border-secondary my-4" />

            <!-- Enlace al Modal de Medios de Pago -->
            <div class="mb-4">
                <button type="button" class="btn btn-link text-secondary text-decoration-underline p-0 fs-7 text-uppercase fw-semibold" data-bs-toggle="modal" data-bs-target="#mediosPagoModal">
                    <i class="bi bi-credit-card me-2"></i> Ver medios de pago
                </button>
            </div>

            <!-- Indicador de Disponibilidad y Stock dinámico -->
            <div class="mb-3">
                @if (Model.Stock > 0)
                {
                    <span class="text-danger fw-bold fs-7 d-flex align-items-center mb-1">
                        <span class="bg-danger rounded-circle me-2 d-inline-block" style="width: 8px; height: 8px;"></span>
                        ¡Única unidad disponible!
                    </span>
                    <small class="text-secondary">Stock restante: @Model.Stock unidad(es)</small>
                }
                else
                {
                    <span class="text-muted fw-bold fs-7 d-flex align-items-center">
                        <span class="bg-secondary rounded-circle me-2 d-inline-block" style="width: 8px; height: 8px;"></span>
                        Producto Agotado
                    </span>
                }
            </div>

            <!-- Formulario y Botón Agregar al Carrito -->
            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mb-4">
                <input type="hidden" name="productoId" value="@Model.Id" />
                <input type="hidden" name="cantidad" value="1" />
                <button type="submit" class="btn btn-vault-action rounded-0 w-100 text-uppercase" @(Model.Stock <= 0 ? "disabled" : "")>
                    <i class="bi bi-bag-plus me-2"></i> AGREGAR AL CARRITO
                </button>
            </form>

            <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100 text-uppercase py-2 rounded-0 fs-7 fw-semibold">
                <i class="bi bi-arrow-left me-2"></i> Volver al Catálogo
            </a>

            <!-- Redes sociales -->
            <div class="d-flex gap-3 text-secondary mt-4 border-top border-secondary pt-3 fs-5">
                <a href="#" class="text-secondary"><i class="bi bi-facebook"></i></a>
                <a href="#" class="text-secondary"><i class="bi bi-instagram"></i></a>
                <a href="#" class="text-secondary"><i class="bi bi-share"></i></a>
            </div>
        </div>

    </div>

    <!-- SECCIÓN INFERIOR: DESCRIPCIÓN Y ESPECIFICACIONES ESTILIZADAS -->
    <div class="row mt-5 pt-4 border-top border-secondary">
        <div class="col-12 col-lg-8">
            <h4 class="text-white text-uppercase fw-bold mb-4 tracking-wide fs-5">
                Detalles de la Prenda
            </h4>

            <div class="desc-card mb-4">
                <!-- Badges tácticos de características -->
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="spec-badge"><i class="bi bi-patch-check me-1"></i> Original</span>
                    <span class="spec-badge"><i class="bi bi-star me-1"></i> Estado: 9/10 Workwear</span>
                    <span class="spec-badge"><i class="bi bi-globe me-1"></i> Made in USA</span>
                    <span class="spec-badge"><i class="bi bi-tag me-1"></i> 100% Algodón Rígido</span>
                </div>

                <!-- Descripción traída desde Supabase respetando saltos de línea -->
                <div class="text-light lh-lg fs-7 mb-4" style="white-space: pre-line; color: #DDDDDD;">
                    @Model.Description
                </div>

                <!-- Tabla visual para guía de medidas -->
                <h5 class="text-white text-uppercase fw-bold fs-6 mb-3 border-bottom border-secondary pb-2">
                    <i class="bi bi-ruler me-2"></i> Guía de Medidas (Tomadas de lado a lado)
                </h5>
                <div class="table-responsive">
                    <table class="table table-dark table-borderless text-light fs-7 mb-0">
                        <tbody>
                            <tr class="border-bottom border-secondary">
                                <td class="text-secondary text-uppercase fw-semibold ps-0">Talle</td>
                                <td class="text-end fw-bold">42 (Chequear medidas)</td>
                            </tr>
                            <tr class="border-bottom border-secondary">
                                <td class="text-secondary text-uppercase fw-semibold ps-0">Ancho de Cintura</td>
                                <td class="text-end fw-bold">42 cm</td>
                            </tr>
                            <tr class="border-bottom border-secondary">
                                <td class="text-secondary text-uppercase fw-semibold ps-0">Largo Total</td>
                                <td class="text-end fw-bold">104 cm</td>
                            </tr>
                            <tr>
                                <td class="text-secondary text-uppercase fw-semibold ps-0">Botamanga</td>
                                <td class="text-end fw-bold">24 cm</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- MODAL: MEDIOS DE PAGO HABILITADOS (Efectivo, QR y Transferencia) -->
<div class="modal fade" id="mediosPagoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-black border border-secondary text-light">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title text-uppercase fw-bold fs-6">Medios de Pago Aceptados</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <div class="d-flex align-items-center mb-3 p-3 bg-dark border border-secondary">
                    <i class="bi bi-cash-stack fs-3 text-warning me-3"></i>
                    <div>
                        <strong class="d-block text-uppercase fs-7">Efectivo</strong>
                        <small class="text-secondary">Pago presencial al momento del retiro o contra entrega</small>
                    </div>
                </div>
                <div class="d-flex align-items-center mb-3 p-3 bg-dark border border-secondary">
                    <i class="bi bi-qr-code-scan fs-3 text-warning me-3"></i>
                    <div>
                        <strong class="d-block text-uppercase fs-7">Pago por QR</strong>
                        <small class="text-secondary">Compatible con cualquier aplicación bancaria boliviana</small>
                    </div>
                </div>
                <div class="d-flex align-items-center p-3 bg-dark border border-secondary">
                    <i class="bi bi-bank fs-3 text-warning me-3"></i>
                    <div>
                        <strong class="d-block text-uppercase fs-7">Transferencia Bancaria</strong>
                        <small class="text-secondary">Recibe un 10% de descuento automático en tu compra</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JAVASCRIPT: LUPA Y GALERÍA -->
<script>
    // Cambiar la imagen principal mediante la galería lateral
    function changeMainImage(src, element) {
        document.getElementById('mainProductImage').src = src;
        document.querySelectorAll('.thumb-img').forEach(img => img.classList.remove('active'));
        element.classList.add('active');
    }

    // Activar zoom de la lupa al mover el mouse
    function zoomIn(event) {
        const zoomArea = document.getElementById('zoomArea');
        const mainImg = document.getElementById('mainProductImage');
        const rect = zoomArea.getBoundingClientRect();

        const x = ((event.clientX - rect.left) / rect.width) * 100;
        const y = ((event.clientY - rect.top) / rect.height) * 100;

        mainImg.style.transformOrigin = `${x}% ${y}%`;
        mainImg.style.transform = "scale(2.2)";
    }

    // Restaurar imagen al salir del área
    function zoomOut() {
        const mainImg = document.getElementById('mainProductImage');
        mainImg.style.transform = "scale(1)";
        mainImg.style.transformOrigin = "center center";
    }
</script>