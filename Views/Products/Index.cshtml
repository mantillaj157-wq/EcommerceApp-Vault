@model IEnumerable<Ecommerce_Vault.Models.Product>

@{
    ViewData["Title"] = ViewBag.CurrentCategory ?? "Productos";
    string currentCategory = ViewBag.CurrentCategory ?? "Productos";
    string searchString = ViewBag.SearchString;

    // Si la base de datos no tiene productos registrados, genera 6 productos de prueba estáticos
    var productsList = (Model != null && Model.Any())
        ? Model.ToList()
        : new List<Ecommerce_Vault.Models.Product>
        {
            new Ecommerce_Vault.Models.Product { Id = 1, Name = "OVERSIZED HOODIE BLACK", Price = 120.00m, ImageUrl = "https://images.unsplash.com/photo-1556905055-8f358a7a47b2?q=80&w=800&auto=format&fit=crop" },
            new Ecommerce_Vault.Models.Product { Id = 2, Name = "VINTAGE DENIM JACKET", Price = 180.00m, ImageUrl = "https://images.unsplash.com/photo-1576995853123-5a10305d93c0?q=80&w=800&auto=format&fit=crop" },
            new Ecommerce_Vault.Models.Product { Id = 3, Name = "CARGO PANTS BEIGE", Price = 95.00m, ImageUrl = "https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?q=80&w=800&auto=format&fit=crop" },
            new Ecommerce_Vault.Models.Product { Id = 4, Name = "GRAPHIC T-SHIRT VAULT", Price = 55.00m, ImageUrl = "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=800&auto=format&fit=crop" },
            new Ecommerce_Vault.Models.Product { Id = 5, Name = "MINIMALIST SNEAKERS", Price = 210.00m, ImageUrl = "https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?q=80&w=800&auto=format&fit=crop" },
            new Ecommerce_Vault.Models.Product { Id = 6, Name = "LEATHER CAP URBAN", Price = 45.00m, ImageUrl = "https://images.unsplash.com/photo-1588850561407-ed78c282e89b?q=80&w=800&auto=format&fit=crop" }
        };
}

<!-- Estilos específicos para la vista de Productos estilo Vault -->
<style>
    .vault-breadcrumb {
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .vault-product-card {
        background-color: #000;
        border: none;
        transition: transform 0.2s ease-in-out;
    }

    .vault-img-container {
        position: relative;
        overflow: hidden;
        background-color: #121212;
        aspect-ratio: 1 / 1; /* Mantiene la proporción cuadrada exacta */
    }

        .vault-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

    .btn-vault-cart {
        background-color: #8C6D53;
        color: #ffffff;
        border: none;
        text-transform: uppercase;
        font-weight: 700;
        font-size: 0.75rem;
        letter-spacing: 1px;
        padding: 8px 16px;
        transition: background-color 0.2s ease;
    }

        .btn-vault-cart:hover {
            background-color: #a37a5b;
            color: #ffffff;
        }

    .btn-vault-more {
        background-color: #8C6D53;
        color: #ffffff;
        border: none;
        text-transform: uppercase;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 1.5px;
        padding: 12px 35px;
        transition: background-color 0.2s ease;
    }

        .btn-vault-more:hover {
            background-color: #a37a5b;
            color: #ffffff;
        }

    .btn-admin-create {
        background-color: transparent;
        color: #ffc107;
        border: 1px solid #ffc107;
        text-transform: uppercase;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 1px;
        padding: 8px 20px;
        transition: all 0.2s ease;
    }

        .btn-admin-create:hover {
            background-color: #ffc107;
            color: #000000;
        }

    .vault-sort-select {
        background-color: #0d0d0d;
        color: #fff;
        border: 1px solid #444;
        font-size: 0.85rem;
        padding: 5px 12px;
        border-radius: 0;
    }

        .vault-sort-select:focus {
            background-color: #0d0d0d;
            color: #fff;
            border-color: #8C6D53;
            box-shadow: none;
        }
</style>

<div class="container py-2">
    <!-- BARRA DE ADMINISTRACIÓN (Poblada únicamente para el Rol de Admin) -->
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <div class="d-flex justify-content-between align-items-center bg-dark p-3 mb-4 border border-warning rounded-0">
            <span class="text-warning fw-bold text-uppercase fs-7">
                <i class="bi bi-shield-lock-fill me-2"></i> Panel de Administración
            </span>
            <a asp-action="Create" class="btn btn-admin-create rounded-0">
                <i class="bi bi-plus-lg me-1"></i> Crear Producto
            </a>
        </div>
    }

    <!-- Encabezado Superior: Breadcrumbs y Ordenar por -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-dark">
        <!-- Breadcrumbs -->
        <div class="vault-breadcrumb text-light">
            <a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none">Inicio</a>
            <span class="text-secondary mx-1">/</span>
            <span class="text-white text-capitalize">@currentCategory</span>
            @if (!string.IsNullOrEmpty(searchString))
            {
                <span class="text-secondary ms-2">(Búsqueda: "@searchString")</span>
            }
        </div>

        <!-- Filtro Ordenar Por -->
        <div class="d-flex align-items-center gap-2">
            <label for="sortOrder" class="text-secondary small text-nowrap d-none d-sm-inline">Ordenar por</label>
            <select id="sortOrder" class="form-select form-select-sm vault-sort-select">
                <option value="newest">Más nuevo al más viejo</option>
                <option value="oldest">Más viejo al más nuevo</option>
                <option value="price-low">Precio: Menor a Mayor</option>
                <option value="price-high">Precio: Mayor a Menor</option>
            </select>
        </div>
    </div>

    <!-- Grilla de Productos (3 Columnas por Fila) -->
    <div class="row g-4 mb-5">
        @foreach (var item in productsList)
        {
            var transferPrice = item.Price * 0.90m;

            <div class="col-12 col-sm-6 col-md-4">
                <div class="card vault-product-card h-100 text-center">
                    <!-- Imagen del producto -->
                    <div class="vault-img-container mb-3">
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.jpg" : item.ImageUrl)"
                                 alt="@item.Name"
                                 loading="lazy" />
                        </a>
                    </div>

                    <!-- Información del Producto -->
                    <div class="card-body p-0 d-flex flex-column justify-content-between">
                        <div>
                            <!-- Nombre del producto -->
                            <h6 class="text-uppercase fw-bold text-light mb-2 fs-7 tracking-wide" style="font-size: 0.85rem;">
                                @item.Name
                            </h6>

                            <!-- Precio Normal -->
                            <div class="fw-black text-white fs-5 mb-1">
                                $@item.Price.ToString("N2")
                            </div>

                            <!-- Precio con Transferencia -->
                            <div class="text-secondary mb-3 fs-7" style="font-size: 0.8rem;">
                                <span class="fw-bold text-light">$@transferPrice.ToString("N2")</span> con Transferencia
                            </div>
                        </div>

                        <!-- Formulario para Agregar al Carrito -->
                        <div class="mt-2">
                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                <input type="hidden" name="productoId" value="@item.Id" />
                                <input type="hidden" name="cantidad" value="1" />
                                <button type="submit" class="btn btn-vault-cart rounded-0 w-100 mb-2">
                                    <i class="bi bi-cart-plus me-1"></i> AGREGAR AL CARRITO
                                </button>
                            </form>

                            <!-- Acciones Exclusivas del Administrador -->
                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                            {
                                <div class="d-flex justify-content-center gap-2 mt-2 pt-2 border-top border-secondary">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-0 w-50" style="font-size: 0.75rem;">
                                        Editar
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-0 w-50" style="font-size: 0.75rem;">
                                        Eliminar
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Botón Mostrar Más Productos -->
    <div class="text-center my-5 pt-3">
        <button class="btn btn-vault-more rounded-0">
            MOSTRAR MÁS PRODUCTOS
        </button>
    </div>
</div>