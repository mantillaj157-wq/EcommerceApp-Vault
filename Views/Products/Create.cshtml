@model Ecommerce_Vault.Models.Product

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container my-4" style="max-width: 600px;">
    <h2 class="text-uppercase fw-black text-light mb-4 tracking-wide">Crear Nuevo Producto</h2>

    <form asp-action="Create" method="post" class="bg-dark p-4 border border-secondary shadow">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Nombre del Producto -->
        <div class="mb-3">
            <label asp-for="Name" class="form-label text-light text-uppercase fw-semibold fs-7">Nombre del Producto</label>
            <input asp-for="Name" class="form-control bg-black text-light border-secondary rounded-0 shadow-none" placeholder="Ej: Cargo Short Carhartt" required />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <!-- Categoría -->
        <div class="mb-3">
            <label asp-for="Category" class="form-label text-light text-uppercase fw-semibold fs-7">Categoría</label>
            <select asp-for="Category" class="form-select bg-black text-light border-secondary rounded-0 shadow-none" required>
                <option value="">-- SELECCIONAR CATEGORÍA --</option>
                <option value="Partes de Abajo">Partes de Abajo</option>
                <option value="Partes de Arriba">Partes de Arriba</option>
                <option value="Ofertas">Ofertas</option>
            </select>
            <span asp-validation-for="Category" class="text-danger small"></span>
        </div>

        <!-- Precio y Stock -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Price" class="form-label text-light text-uppercase fw-semibold fs-7">Precio (Bs.)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control bg-black text-light border-secondary rounded-0 shadow-none" required />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Stock" class="form-label text-light text-uppercase fw-semibold fs-7">Stock</label>
                <input asp-for="Stock" type="number" class="form-control bg-black text-light border-secondary rounded-0 shadow-none" value="1" required />
                <span asp-validation-for="Stock" class="text-danger small"></span>
            </div>
        </div>

        <!-- URL de la Imagen Principal -->
        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label text-light text-uppercase fw-semibold fs-7">URL de la Imagen Principal</label>
            <input asp-for="ImageUrl" class="form-control bg-black text-light border-secondary rounded-0 shadow-none" placeholder="https://..." required />
            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
        </div>

        <!-- CAMPO NUEVO: URLs de Imágenes Adicionales -->
        <div class="mb-3">
            <label class="form-label text-light text-uppercase fw-semibold fs-7">Imágenes Adicionales de Galería (URLs separadas por comas)</label>
            <textarea name="additionalImages" class="form-control bg-black text-light border-secondary rounded-0 shadow-none" rows="3" placeholder="https://imagen2.jpg, https://imagen3.jpg"></textarea>
            <small class="text-secondary" style="font-size: 0.75rem;">Pega las URLs de las fotos de los detalles separadas por comas.</small>
        </div>

        <!-- Descripción -->
        <div class="mb-3">
            <label asp-for="Description" class="form-label text-light text-uppercase fw-semibold fs-7">Descripción y Medidas</label>
            <textarea asp-for="Description" class="form-control bg-black text-light border-secondary rounded-0 shadow-none" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <!-- Botones de Acción -->
        <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top border-secondary">
            <a asp-action="Index" class="btn btn-outline-light rounded-0 text-uppercase fw-semibold fs-7 px-4">Cancelar</a>
            <button type="submit" class="btn rounded-0 text-uppercase fw-bold fs-7 px-4" style="background-color: #8C6D53; border-color: #8C6D53; color: #fff;">
                Guardar Producto
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}