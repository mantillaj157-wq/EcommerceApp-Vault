@using Ecommerce_Vault.Extensions
@using Ecommerce_Vault.Models.ViewModels

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VAULT | Vintage & Streetwear</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Google Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;900&family=Inter:wght@300;400;600&display=swap">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Configuración PWA -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#8C6D53" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href="~/images/icon-192.png" />

    <style>
            /* Banner Flotante de Instalación PWA estilo Vault */
            #pwaInstallBanner {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                background-color: #0d0d0d;
                border-top: 2px solid #8C6D53;
                z-index: 9998;
                box-shadow: 0 -5px 25px rgba(0, 0, 0, 0.8);
                transform: translateY(100%);
                transition: transform 0.4s ease-in-out;
            }

                #pwaInstallBanner.show {
                    transform: translateY(0);
                }

            .btn-vault-install {
                background-color: #8C6D53;
                color: #ffffff;
                border: none;
                font-weight: 700;
                font-size: 0.8rem;
                letter-spacing: 1px;
                padding: 8px 18px;
                text-transform: uppercase;
            }

                .btn-vault-install:hover {
                    background-color: #a37a5b;
                    color: #ffffff;
                }

            /* Botón Flotante Inferior Derecho (Estilo Vintage Vault) */
            .voice-float-btn {
                position: fixed;
                bottom: 25px;
                right: 25px;
                width: 58px;
                height: 58px;
                background-color: #8C6D53;
                color: #ffffff;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
                cursor: pointer;
                z-index: 9999;
                border: 2px solid rgba(255, 255, 255, 0.2);
                transition: transform 0.2s ease, background-color 0.3s ease;
            }

                .voice-float-btn:hover {
                    transform: scale(1.08);
                    background-color: #a37a5b;
                    color: #ffffff;
                }

            /* Animación Parpadeo Rojo durante Escucha */
            .listening-active {
                background-color: #dc3545 !important;
                color: #ffffff !important;
                animation: pulse-mic 1.2s infinite;
            }

            @@keyframes pulse-mic {
                0% {
                    box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
                }

                70% {
                    box-shadow: 0 0 0 15px rgba(220, 53, 69, 0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
                }
            }
    </style>
</head>
<body class="bg-black text-light d-flex flex-column min-vh-100">

    <!-- Anuncio Superior con Fondo Café Claro -->
    <div class="text-white text-center py-2 fs-7 fw-semibold border-bottom border-secondary tracking-wide" style="background-color: #8C6D53;">
        ⚡ PIEZAS ÚNICAS SELECCIONADAS • ENVÍOS A TODO EL PAÍS • VINTAGE & STREETWEAR ⚡
    </div>

    <!-- Header Principal -->
    <header class="bg-black border-bottom border-secondary sticky-top">
        <div class="container py-3">
            <!-- Logotipo Rediseñado: VAULT (Apunta a Home/Index) -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <a class="navbar-brand text-uppercase tracking-ultra my-1 d-inline-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="vault-logo-badge me-2">V</span>
                    <span class="fw-black fs-1 text-white tracking-widest">VAULT</span>
                    <span class="vault-dot ms-1">.</span>
                </a>
            </div>

            <!-- Navegación estilo Vintage Vault -->
            <nav class="navbar navbar-expand-lg navbar-dark p-0">
                <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 text-uppercase fw-semibold fs-7 tracking-wide gap-lg-4">
                        @{
                            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                        }

                        <!-- INICIO -->
                        <li class="nav-item">
                            <a class="nav-link text-light @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">INICIO</a>
                        </li>

                        <!-- PRODUCTOS CON DROPDOWN -->
                        <li class="nav-item dropdown custom-dropdown">
                            <a class="nav-link text-light dropdown-toggle @(currentController == "Products" ? "active" : "")"
                               asp-controller="Products" asp-action="Index" id="navbarDropdownProducts" role="button">
                                PRODUCTOS
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark custom-dropdown-menu rounded-0 p-0 m-0" aria-labelledby="navbarDropdownProducts">
                                <li>
                                    <a class="dropdown-item custom-dropdown-item d-flex justify-content-between align-items-center py-3 px-4 text-uppercase fw-semibold"
                                       asp-controller="Products" asp-action="Index" asp-route-category="Abajo">
                                        PARTES DE ABAJO
                                        <i class="bi bi-chevron-right fs-7 ms-3"></i>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item custom-dropdown-item d-flex justify-content-between align-items-center py-3 px-4 text-uppercase fw-semibold"
                                       asp-controller="Products" asp-action="Index" asp-route-category="Arriba">
                                        PARTES DE ARRIBA
                                        <i class="bi bi-chevron-right fs-7 ms-3"></i>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- TALLES -->
                        <li class="nav-item">
                            <a class="nav-link text-light @(currentController == "Home" && currentAction == "Talles" ? "active" : "")"
                               asp-controller="Home" asp-action="Talles">TALLES</a>
                        </li>

                        <!-- PREGUNTAS -->
                        <li class="nav-item">
                            <a class="nav-link text-light @(currentController == "Home" && currentAction == "Preguntas" ? "active" : "")"
                               asp-controller="Home" asp-action="Preguntas">PREGUNTAS</a>
                        </li>
                    </ul>

                    <!-- Derecha: Buscador con Micrófono Integrado, Cuenta, Carrito -->
                    <div class="d-flex align-items-center gap-3 ms-auto mt-3 mt-lg-0">
                        <!-- Formulario de Búsqueda con Micrófono Integrado -->
                        <form id="searchForm" class="d-flex align-items-center border-bottom border-secondary pb-1 me-2" role="search" method="get" asp-controller="Products" asp-action="Index">
                            <input id="searchInput" class="form-control form-control-sm bg-transparent border-0 text-light shadow-none p-0 pe-2" type="search" name="searchString" placeholder="BUSCAR" aria-label="Buscar" style="width: 120px; font-size: 0.8rem;">

                            <!-- Botón de Micrófono (Búsqueda por Voz) al lado de la Lupa -->
                            <button id="btnHeaderVoice" class="btn btn-sm p-0 text-secondary me-2" type="button" title="Buscar por voz">
                                <i id="micHeaderIcon" class="bi bi-mic-fill fs-6"></i>
                            </button>

                            <!-- Lupa de Búsqueda -->
                            <button class="btn btn-sm p-0 text-light" type="submit">
                                <i class="bi bi-search fs-6"></i>
                            </button>
                        </form>

                        <!-- Menú Cuenta -->
                        <div class="dropdown">
                            <a href="#" class="text-light text-decoration-none dropdown-toggle d-flex align-items-center" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person fs-5"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark text-small shadow" aria-labelledby="userMenu">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <li><span class="dropdown-item-text text-warning fw-bold">@User.Identity.Name</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger">Cerrar Sesión</button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Iniciar Sesión</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Crear Cuenta</a></li>
                                }
                            </ul>
                        </div>

                        <!-- Carrito con contador dinámico basado en la sesión -->
                        @{
                            var sessionCart = Context.Session.GetObjectFromJson<List<CartItemViewModel>>("CartSession");
                            int cartCount = sessionCart != null ? sessionCart.Sum(x => x.Cantidad) : 0;
                        }
                        <a href="/Cart" class="text-light text-decoration-none d-flex align-items-center ms-2" title="Ver Carrito">
                            <i class="bi bi-cart3 fs-5"></i>
                            <span class="badge rounded-pill bg-warning text-dark ms-1" style="font-size: 0.7rem;">@cartCount</span>
                        </a>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <!-- Contenido -->
    <div class="container my-5 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- BOTÓN FLOTANTE INFERIOR DERECHO DE BÚSQUEDA POR VOZ -->
    <div id="btnFloatingVoice" class="voice-float-btn" title="Presiona para navegar o buscar por voz">
        <i id="micFloatingIcon" class="bi bi-mic-fill fs-4"></i>
    </div>

    <!-- BANNER FLOTANTE DE INSTALACIÓN PWA -->
    <div id="pwaInstallBanner" class="py-3 px-3">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span class="vault-logo-badge bg-warning text-dark fw-bold px-2 py-1 fs-6">V</span>
                <div>
                    <h6 class="mb-0 text-white text-uppercase fw-bold fs-7">Instalar App VAULT</h6>
                    <small class="text-secondary fs-8">Instala la aplicación para una mejor experiencia</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button id="btnPwaInstall" class="btn btn-vault-install rounded-0">INSTALAR</button>
                <button id="btnPwaClose" class="btn btn-sm text-secondary p-1"><i class="bi bi-x-lg fs-6"></i></button>
            </div>
        </div>
    </div>

    <!-- Footer Completo estilo Vintage Vault -->
    <footer class="bg-black text-light py-5 border-top border-secondary mt-auto">
        <div class="container">
            <div class="row g-4">
                <!-- Columna 1: NAVEGACIÓN -->
                <div class="col-12 col-md-4">
                    <h6 class="fw-black text-uppercase tracking-wide text-white mb-3 fs-7">NAVEGACIÓN</h6>
                    <ul class="list-unstyled small text-uppercase lh-lg m-0">
                        <li><a class="text-secondary text-decoration-none hover-warning" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li><a class="text-secondary text-decoration-none hover-warning" asp-controller="Products" asp-action="Index">Productos</a></li>
                        <li><a class="text-secondary text-decoration-none hover-warning" href="#">Ofertas</a></li>
                        <li><a class="text-secondary text-decoration-none hover-warning" asp-controller="Home" asp-action="Talles">Talles</a></li>
                        <li><a class="text-secondary text-decoration-none hover-warning" asp-controller="Home" asp-action="Preguntas">Preguntas</a></li>
                    </ul>
                </div>

                <!-- Columna 2: CONTACTANOS -->
                <div class="col-12 col-md-4">
                    <h6 class="fw-black text-uppercase tracking-wide text-white mb-3 fs-7">CONTACTANOS</h6>
                    <div class="small text-secondary lh-lg">
                        <p class="mb-2 d-flex align-items-center">
                            <i class="bi bi-envelope me-2 text-white"></i>
                            <a href="mailto:mantillaj157@gmail.com" class="text-secondary text-decoration-none hover-warning">mantillaj157@gmail.com</a>
                        </p>
                        <p class="mb-0 d-flex align-items-center">
                            <i class="bi bi-geo-alt me-2 text-white"></i>
                            General Alvear 245, Martínez, Buenos Aires
                        </p>
                    </div>
                </div>

                <!-- Columna 3: REDES SOCIALES Y NEWSLETTER -->
                <div class="col-12 col-md-4">
                    <h6 class="fw-black text-uppercase tracking-wide text-white mb-3 fs-7">REDES SOCIALES</h6>
                    <div class="d-flex gap-3 mb-4 fs-5">
                        <a href="#" class="text-light hover-warning"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-light hover-warning"><i class="bi bi-tiktok"></i></a>
                    </div>

                    <h6 class="fw-black text-uppercase tracking-wide text-white mb-2 fs-7">¡NO TE PIERDAS DE LAS NOVEDADES!</h6>
                    <form class="d-flex border border-secondary" onsubmit="event.preventDefault();">
                        <input type="email" class="form-control bg-transparent border-0 text-light shadow-none fs-7" placeholder="Email" required>
                        <button class="btn btn-link text-light p-2" type="submit">
                            <i class="bi bi-send-fill fs-6"></i>
                        </button>
                    </form>
                </div>
            </div>

            <div class="border-top border-secondary mt-5 pt-3 text-center text-muted fs-7">
                <p class="mb-0">VAULT &copy; 2026 • Todos los derechos reservados</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- LÓGICA INTEGRADORA DE WEB SPEECH API (NAVEGACIÓN + BÚSQUEDA) & PWA -->
    <script>
            const btnHeaderVoice = document.getElementById('btnHeaderVoice');
            const btnFloatingVoice = document.getElementById('btnFloatingVoice');
            const searchInput = document.getElementById('searchInput');
            const searchForm = document.getElementById('searchForm');
            const micHeaderIcon = document.getElementById('micHeaderIcon');
            const micFloatingIcon = document.getElementById('micFloatingIcon');

            // Función para limpiar texto antes de evaluar el comando
            function normalizarTexto(texto) {
                return texto
                    .toLowerCase()
                    .trim()
                    .normalize("NFD")
                    .replace(/[\u0300-\u036f]/g, "") // Remueve tildes
                    .replace(/[.,\/#!$%\^&\*;:{}=\-_`~()]/g, ""); // Remueve signos
            }

            // Mapa de Comandos para Navegación General de la App
            const comandosNavegacion = [
                { claves: ["inicio", "home", "ir a inicio", "principal"], url: "/" },
                { claves: ["productos", "producto", "ver productos", "catalogo"], url: "/Products" },
                { claves: ["partes de arriba", "arriba"], url: "/Products?category=Arriba" },
                { claves: ["partes de abajo", "abajo"], url: "/Products?category=Abajo" },
                { claves: ["talles", "talle", "guia de talles"], url: "/Home/Talles" },
                { claves: ["preguntas", "pregunta", "preguntas frecuentes", "ayuda"], url: "/Home/Preguntas" },
                { claves: ["iniciar sesion", "ingresar", "login", "entrar"], url: "/Account/Login" },
                { claves: ["crear cuenta", "registrarse", "registro", "nueva cuenta"], url: "/Account/Register" },
                { claves: ["carrito", "ir al carrito", "ver carrito", "compras"], url: "/Cart" }
            ];

            // Inicializar Web Speech API
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

            if (SpeechRecognition) {
                const recognition = new SpeechRecognition();
                recognition.lang = 'es-ES';
                recognition.continuous = false;
                recognition.interimResults = false;

                function startListening() {
                    try {
                        recognition.start();
                    } catch (e) {
                        console.log('Reconocimiento activo');
                    }
                }

                if (btnHeaderVoice) btnHeaderVoice.addEventListener('click', startListening);
                if (btnFloatingVoice) btnFloatingVoice.addEventListener('click', startListening);

                recognition.onstart = () => {
                    if (micHeaderIcon) micHeaderIcon.className = "bi bi-mic-fill text-danger animate-pulse";
                    if (btnFloatingVoice) btnFloatingVoice.classList.add('listening-active');
                    if (searchInput) searchInput.placeholder = "Escuchando...";
                };

                // Procesa la voz: si es comando navega, si es otra cosa realiza la búsqueda
                recognition.onresult = (event) => {
                    const transcript = event.results[0][0].transcript;
                    const comandoLimpio = normalizarTexto(transcript);

                    resetMicUI();

                    // 1. Verificar si coincide con algún comando de navegación
                    let destinoNavegacion = null;
                    for (const cmd of comandosNavegacion) {
                        if (cmd.claves.some(clave => comandoLimpio.includes(clave))) {
                            destinoNavegacion = cmd.url;
                            break;
                        }
                    }

                    // 2. Ejecutar la acción correspondiente
                    if (destinoNavegacion) {
                        window.location.href = destinoNavegacion; // Redirige a la sección elegida
                    } else {
                        // Si no es un comando de la lista, realiza una búsqueda directa
                        if (searchInput) {
                            searchInput.value = transcript;
                        }
                        if (searchForm) {
                            searchForm.submit();
                        }
                    }
                };

                recognition.onerror = () => resetMicUI();
                recognition.onend = () => resetMicUI();

                function resetMicUI() {
                    if (micHeaderIcon) micHeaderIcon.className = "bi bi-mic-fill text-secondary";
                    if (btnFloatingVoice) btnFloatingVoice.classList.remove('listening-active');
                    if (searchInput) searchInput.placeholder = "BUSCAR";
                }
            } else {
                if (btnHeaderVoice) btnHeaderVoice.style.display = 'none';
                if (btnFloatingVoice) btnFloatingVoice.style.display = 'none';
            }

            // Lógica de PWA
            let deferredPrompt;
            const pwaBanner = document.getElementById('pwaInstallBanner');
            const btnInstall = document.getElementById('btnPwaInstall');
            const btnClose = document.getElementById('btnPwaClose');

            window.addEventListener('beforeinstallprompt', (e) => {
                e.preventDefault();
                deferredPrompt = e;
                if (pwaBanner) pwaBanner.classList.add('show');
            });

            if (btnInstall) {
                btnInstall.addEventListener('click', async () => {
                    if (deferredPrompt) {
                        deferredPrompt.prompt();
                        const { outcome } = await deferredPrompt.userChoice;
                        deferredPrompt = null;
                    }
                    pwaBanner.classList.remove('show');
                });
            }

            if (btnClose) {
                btnClose.addEventListener('click', () => {
                    pwaBanner.classList.remove('show');
                });
            }

            if ('serviceWorker' in navigator) {
                window.addEventListener('load', () => {
                    navigator.serviceWorker.register('/sw.js').catch(err => console.log(err));
                });
            }
    </script>
</body>
</html>