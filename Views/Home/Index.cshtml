@model List<Ecommerce_Vault.Models.Product>

@{
    ViewData["Title"] = "Inicio";
}

<!-- BANNER HERO (Grid 2x2 + Texto) -->
<div class="row align-items-center my-4 py-3">
    <div class="col-lg-6 col-md-12 mb-4 mb-lg-0">
        <div class="hero-grid">
            <div class="hero-grid-item">
                <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?q=80&w=600" alt="Drop 1" class="img-fluid hero-img">
            </div>
            <div class="hero-grid-item">
                <img src="https://images.unsplash.com/photo-1576995853123-5a10305d93c0?q=80&w=600" alt="Drop 2" class="img-fluid hero-img">
            </div>
            <div class="hero-grid-item">
                <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=600" alt="Drop 3" class="img-fluid hero-img">
            </div>
            <div class="hero-grid-item">
                <img src="https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?q=80&w=600" alt="Drop 4" class="img-fluid hero-img">
            </div>
        </div>
    </div>

    <div class="col-lg-6 col-md-12 text-center text-lg-start ps-lg-5">
        <h1 class="hero-title text-uppercase fw-black text-white display-4 tracking-wide lh-sm mb-3">
            NUEVO DROP.<br>VIERNES 25/09,<br>20:00 HS.
        </h1>
        <p class="text-secondary text-uppercase tracking-wider fs-6">
            Piezas únicas seleccionadas • Stock limitado
        </p>
    </div>
</div>

<hr class="border-secondary my-5" />

<!-- 3 CATEGORÍAS (ARRIBA, ABAJO, OFERTAS) -->
<div class="row g-4 mb-5">
    <div class="col-12 col-md-4">
        <div class="category-card position-relative overflow-hidden">
            <img src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?q=80&w=800" alt="Arriba" class="category-img w-100 h-100">
            <div class="category-overlay d-flex flex-column align-items-center justify-content-center">
                <h2 class="category-title text-white fw-black text-uppercase tracking-widest mb-3">ARRIBA</h2>
                <a href="@Url.Action("Index", new { category = "Arriba" })" class="btn btn-category-more text-uppercase fw-bold rounded-0">VER MÁS</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="category-card position-relative overflow-hidden">
            <img src="https://images.unsplash.com/photo-1541099649105-f69ad21f3246?q=80&w=800" alt="Abajo" class="category-img w-100 h-100">
            <div class="category-overlay d-flex flex-column align-items-center justify-content-center">
                <h2 class="category-title text-white fw-black text-uppercase tracking-widest mb-3">ABAJO</h2>
                <a href="@Url.Action("Index", new { category = "Abajo" })" class="btn btn-category-more text-uppercase fw-bold rounded-0">VER MÁS</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="category-card position-relative overflow-hidden">
            <img src="https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?q=80&w=800" alt="Ofertas" class="category-img w-100 h-100">
            <div class="category-overlay d-flex flex-column align-items-center justify-content-center">
                <h2 class="category-title text-white fw-black text-uppercase tracking-widest mb-3">OFERTAS</h2>
                <a href="@Url.Action("Index", new { category = "Ofertas" })" class="btn btn-category-more text-uppercase fw-bold rounded-0">VER MÁS</a>
            </div>
        </div>
    </div>
</div>

<!-- TITULO DIVISOR: VISITÁ NUESTRA SUCURSAL -->
<div class="text-center my-5 py-3">
    <h3 class="fw-black text-uppercase text-white tracking-widest display-6 mb-2">
        VISITÁ NUESTRA SUCURSAL
    </h3>
    <div class="d-flex align-items-center justify-content-center gap-3">
        <div class="border-bottom border-secondary flex-grow-1" style="max-width: 100px;"></div>
        <span class="text-secondary small text-uppercase tracking-wider">CONOCÉ NUESTRO ESPACIO FÍSICO</span>
        <div class="border-bottom border-secondary flex-grow-1" style="max-width: 100px;"></div>
    </div>
</div>

<!-- SECCIÓN SHOWROOM Y UBICACIÓN (2 IMÁGENES INTERACTIVAS) -->
<div class="row g-4 mb-5 justify-content-center">
    <!-- Showroom -->
    <div class="col-12 col-md-6">
        <div class="category-card position-relative overflow-hidden">
            <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?q=80&w=800" alt="Showroom" class="category-img w-100 h-100">
            <div class="category-overlay d-flex flex-column align-items-center justify-content-center">
                <h2 class="category-title text-white fw-black text-uppercase tracking-widest mb-0">showroom</h2>
            </div>
        </div>
    </div>

    <!-- Ubicación Google Maps -->
    <div class="col-12 col-md-6">
        <div class="category-card position-relative overflow-hidden">
            <img src="https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?q=80&w=800" alt="Ubicación" class="category-img w-100 h-100">
            <div class="category-overlay d-flex flex-column align-items-center justify-content-center text-center p-3">
                <p class="text-white fw-bold mb-1 fs-6">General Alvear 245, Martínez, Buenos Aires.</p>
                <p class="text-white-50 small mb-3">Martes a sábados de 14:00 a 19:00 hs.</p>
                <a href="https://maps.google.com" target="_blank" class="btn btn-category-more text-uppercase fw-bold rounded-0">VER EN GOOGLE MAPS</a>
            </div>
        </div>
    </div>
</div>

<!-- BARRA DE INFORMACIÓN Y BENEFICIOS -->
<div class="row py-4 border-top border-bottom border-secondary text-light my-5 align-items-center">
    <!-- Item 1 -->
    <div class="col-12 col-md-4 d-flex align-items-center justify-content-center mb-3 mb-md-0 border-end-md">
        <i class="bi bi-truck fs-2 me-3 text-white"></i>
        <div>
            <h6 class="fw-bold text-uppercase mb-0 tracking-wide fs-7">COMPRÁ DESDE TU CASA</h6>
            <small class="text-secondary">Hacemos envíos a todo el país</small>
        </div>
    </div>

    <!-- Item 2 -->
    <div class="col-12 col-md-4 d-flex align-items-center justify-content-center mb-3 mb-md-0 border-end-md">
        <i class="bi bi-credit-card fs-2 me-3 text-white"></i>
        <div>
            <h6 class="fw-bold text-uppercase mb-0 tracking-wide fs-7">TODOS LOS MEDIOS DE PAGO</h6>
            <small class="text-secondary">Elegí el que te quede más cómodo</small>
        </div>
    </div>

    <!-- Item 3 -->
    <div class="col-12 col-md-4 d-flex align-items-center justify-content-center">
        <i class="bi bi-tag fs-2 me-3 text-white"></i>
        <div>
            <h6 class="fw-bold text-uppercase mb-0 tracking-wide fs-7">VENÍ A PROBARTE TODO</h6>
            <small class="text-secondary">Te esperamos en nuestro showroom</small>
        </div>
    </div>
</div>

<!-- Catálogo de productos general si existen -->
@if (Model != null && Model.Any())
{
    <div class="row g-4 mt-2">
        @foreach (var product in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <div class="card card-vintage h-100">
                    <div class="product-img-wrapper">
                        @if (!string.IsNullOrEmpty(product.Category))
                        {
                            <span class="badge-vintage">@product.Category</span>
                        }
                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://images.unsplash.com/photo-1523381210434-271e8be1f52b?q=80&w=600" : product.ImageUrl)"
                             class="product-img" alt="@product.Name" />
                    </div>

                    <div class="card-body d-flex flex-column justify-content-between p-3">
                        <div>
                            <h6 class="fw-bold text-uppercase text-light mb-1 text-truncate">@product.Name</h6>
                            <p class="text-secondary small mb-2 text-truncate">@product.Description</p>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="fw-bold fs-5 text-warning">@product.Price.ToString("C")</span>
                                <small class="text-secondary">Stock: @product.Stock</small>
                            </div>

                            <div class="d-grid gap-1">
                                <a href="@Url.Action("Details", new { id = product.Id })" class="btn btn-outline-vintage btn-sm text-uppercase tracking-wide">Ver Prenda</a>
                                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                                {
                                    <div class="btn-group w-100 mt-1">
                                        <a href="@Url.Action("Edit", new { id = product.Id })" class="btn btn-sm btn-outline-warning rounded-0">Editar</a>
                                        <a href="@Url.Action("Delete", new { id = product.Id })" class="btn btn-sm btn-outline-danger rounded-0">Eliminar</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}